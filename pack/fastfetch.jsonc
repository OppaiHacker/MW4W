{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Windows 11_small",
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "pipe": false,
    "separator": "  ",
    "color": { "keys": "blue", "title": "cyan" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "", "format": "{name} {version}" },
    { "type": "host",     "key": "" },
    { "type": "uptime",   "key": "" },
    { "type": "packages", "key": "" },
    { "type": "shell",    "key": "" },
    { "type": "terminal", "key": "" },
    { "type": "cpu",      "key": "", "format": "{name} ({cores-logical}t)" },
    { "type": "gpu",      "key": "", "format": "{name}" },
    { "type": "memory",   "key": "󰍛", "format": "{used} / {total} ({percentage})" },
    { "type": "disk",     "key": "", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": "", "format": "{capacity} {status}" },
    "break",
    "colors"
  ]
}
